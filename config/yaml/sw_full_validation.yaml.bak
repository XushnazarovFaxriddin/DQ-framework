connections:
  source_env_var: PROD_ORA_SW_CONN_STR
  source_type: oracle
  target_env_var: PROD_BQ_ALL_CONN_STR
  target_type: bigquery

# alerts:
#   routes:
#     - kind: gchat
#       mode: card

tables:
  # SEAWARE.ACC_COUPON
  - name: ACC_COUPON_VALIDATION
    source:
      table: SEAWARE.ACC_COUPON
    target:
      table: prod-shore.nbx_parse.hvtb_parse_sw_rpl_acc_coupon
    checks:
      - type: aggregations
        tolerance_pct: 5.0
        rules:
          - method: distinct_count
            source_col: COUPON_ID
            target_column: coupon_id

  # SEAWARE.ACC_COUPON_CLASS
  - name: ACC_COUPON_CLASS_VALIDATION
    source:
      table: SEAWARE.ACC_COUPON_CLASS
    target:
      table: prod-shore.nbx_parse.hvtb_parse_sw_rpl_acc_coupon_class
