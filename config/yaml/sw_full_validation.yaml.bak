  # SEAWARE.RES_INVOICE_ITEM
  - name: RES_INVOICE_ITEM_VALIDATION
    source:
      table: SEAWARE.RES_INVOICE_ITEM
    target:
      query: |
        SELECT *
        FROM (
          SELECT
            res_invoice_item_id,
            op
          FROM prod-shore.nbx_parse.hvtb_parse_sw_rpl_res_invoice_item
          QUALIFY ROW_NUMBER() OVER (
            PARTITION BY res_invoice_item_id
            ORDER BY ts_ms DESC, lsn DESC
          ) = 1
        )
        WHERE op != 'd'
    checks:
      - type: aggregations
        tolerance_pct: 5.0             
        rules:
          - method: distinct_count
            source_column: RES_INVOICE_ITEM_ID
            target_column: res_invoice_item_id

