# =============================================================================
# DQF Framework Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Mismatch Range Sampling Configuration (for identifying mismatched ranges)
# -----------------------------------------------------------------------------
DQF_DEFAULT_MISMATCH_CHUNK_SIZE=1000000
DQF_DEFAULT_MISMATCH_MAX_RANGES=5
DQF_DEFAULT_MISMATCH_MAX_SCAN_CHUNKS=100
DQF_DEFAULT_MISMATCH_BINARY_DEPTH=5

# -----------------------------------------------------------------------------
# Mismatch IDs Detection Configuration (for finding exact ID differences)
# Optimized for 10M+ rows using chunked/binary algorithms
# -----------------------------------------------------------------------------
# Chunk size for ID fetching (larger = faster but more memory)
DQF_MISMATCH_IDS_CHUNK_SIZE=500000
# Maximum IDs to export per mismatch type (missing_in_target, extra_in_target)
DQF_MISMATCH_IDS_MAX_IDS=100000
# Enable/disable mismatch IDs detection (true/false)
DQF_MISMATCH_IDS_ENABLED=true
# Number of parallel chunk fetches (for future optimization)
DQF_MISMATCH_IDS_PARALLEL_CHUNKS=4

# -----------------------------------------------------------------------------
# Results Storage Configuration
# -----------------------------------------------------------------------------
DQF_RESULTS_BACKEND=gcs
DQF_RESULTS_BUCKET=dqf-results
DQF_RESULTS_BASE_PATH=mismatch_ids
DQF_RESULTS_PUBLIC_URL_PREFIX=https://storage.cloud.google.com/dqf-results

# -----------------------------------------------------------------------------
# Table Stats Storage Configuration
# -----------------------------------------------------------------------------
DQF_STATS_TABLE=cert-shore-295415.dqf_monitoring.dqf_table_stats
DQF_STATS_PROJECT=cert-shore-295415
